# Profil public du cabinet sur planity.com : simple lien secondaire dans le
# pied de page (la réservation se fait sur ce site, /reserver).
NEXT_PUBLIC_PLANITY_BOOKING_URL=https://www.planity.com/stefania-33000-bordeaux

# Domaine de production (https, sans slash final), ex. https://www.mon-domaine.fr
# Obligatoire avant la mise en ligne : sans lui le site reste en noindex et
# canonical / sitemap / JSON-LD ne sont pas générés. À définir uniquement pour
# l'environnement Production (les previews Vercel restent en noindex).
NEXT_PUBLIC_SITE_URL=

# --- Connexion (Firebase Auth + API de réservation) ---
# Valeurs publiques (non secrètes) de l'application web Firebase :
# Firebase Console → Project settings → General → Your apps → Web app.
# Staging = projet « massage-fr » ; production = projet distinct (à créer).
# Tant qu'une valeur manque, la connexion est désactivée proprement
# (pas de session invitée, page /connexion « indisponible »).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Origine HTTPS de l'API de réservation de MÊME environnement (sans slash
# final). Le backend doit autoriser l'origine de ce site via FRONTEND_URL
# (CORS), sinon les appels /api/me échouent dans le navigateur.
NEXT_PUBLIC_API_BASE_URL=

# Émulateur Firebase Auth (« 127.0.0.1:9099 ») : uniquement en local et pour
# les tests navigateur, avec un projet `demo-*`. Ignoré hors `next dev` et
# hors hôte local. Ne jamais le définir sur Vercel.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=
